<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>CAMP ERP | Multi-Role Login Portal</title>
    <link rel="icon" type="image/png" href="/images/logo/camp-logo.png">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    
    <link rel="stylesheet" href="/css/base/variables.css">
    <link rel="stylesheet" href="/css/base/base.css">
    <link rel="stylesheet" href="/css/base/typography.css">
    <link rel="stylesheet" href="/css/components/buttons.css">
    <link rel="stylesheet" href="/css/components/forms.css">
    <link rel="stylesheet" href="/css/components/cards.css">
    <link rel="stylesheet" href="/css/pages/login.css">
</head>
<body>
    <main class="login-page">
      <div class="overlay"></div>
      <div class="login-container">
        <div class="login-card">
          <div class="logo-section">
            <div class="logo-circle">
              <i class="bi bi-mortarboard-fill"></i>
            </div>
            <h2>CAMP</h2>
            <p>College Attendance Management Portal</p>
          </div>

          <h4 class="text-center mb-3">System Login Portal</h4>

          <% if (typeof error !== 'undefined' && error) { %>
            <div class="alert alert-danger"><%= error %></div>
          <% } %>

          <form id="loginForm" action="/login" method="POST">
            <!-- Role Selection Tabs -->
            <div class="mb-3">
              <label class="form-label font-weight-bold">Select Login Role</label>
              <div class="btn-group w-100" role="group" id="roleBtnGroup">
                <input type="radio" class="btn-check" name="role" id="roleAdmin" value="admin" checked autocomplete="off" onchange="updatePlaceholder()">
                <label class="btn btn-outline-primary" for="roleAdmin"><i class="bi bi-shield-lock-fill me-1"></i> Admin</label>

                <input type="radio" class="btn-check" name="role" id="roleTeacher" value="teacher" autocomplete="off" onchange="updatePlaceholder()">
                <label class="btn btn-outline-primary" for="roleTeacher"><i class="bi bi-person-workspace me-1"></i> Teacher</label>

                <input type="radio" class="btn-check" name="role" id="roleStudent" value="student" autocomplete="off" onchange="updatePlaceholder()">
                <label class="btn btn-outline-primary" for="roleStudent"><i class="bi bi-mortarboard me-1"></i> Student</label>
              </div>
            </div>

            <div class="mb-3">
              <label class="form-label" id="identifierLabel">Email / Identifier</label>
              <input type="text" id="login_identifier" name="login_identifier" class="form-control" placeholder="admin@camp.com" value="admin@camp.com" required />
            </div>

            <div class="mb-3">
              <label for="password" class="form-label">Password</label>
              <div class="password-wrapper">
                <input type="password" id="password" name="password" class="form-control" placeholder="admin123" value="admin123" required />
              </div>
            </div>

            <button type="submit" class="btn-login w-100 mt-2" id="loginButton">
              <span class="btn-text">SIGN IN TO PORTAL</span>
            </button>

            <!-- Student Self Registration Option -->
            <div class="text-center mt-3" id="studentSelfRegBox" style="display: none;">
              <a href="/student/self-register" class="btn btn-outline-success w-100 py-2 font-weight-bold shadow-sm" style="border-radius: 10px;">
                <i class="bi bi-person-plus-fill text-success me-1"></i> New Student? Self Register with Face ID
              </a>
            </div>
          </form>

          <div class="copyright text-center mt-3 text-muted">
            <small>© 2026 CAMP ERP | Multi-Role Access Control</small>
          </div>
        </div>
      </div>
    </main>

    <script>
      function updatePlaceholder() {
        const role = document.querySelector('input[name="role"]:checked').value;
        const identifierLabel = document.getElementById('identifierLabel');
        const inputField = document.getElementById('login_identifier');
        const passField = document.getElementById('password');
        const selfRegBox = document.getElementById('studentSelfRegBox');

        if (role === 'admin') {
          identifierLabel.innerText = 'Admin Email Address';
          inputField.placeholder = 'admin@camp.com';
          inputField.value = 'admin@camp.com';
          passField.value = 'admin123';
          if (selfRegBox) selfRegBox.style.display = 'none';
        } else if (role === 'teacher') {
          identifierLabel.innerText = 'Teacher Email or Employee ID';
          inputField.placeholder = 'teacher@camp.com or EMP101';
          inputField.value = 'teacher@camp.com';
          passField.value = 'teacher123';
          if (selfRegBox) selfRegBox.style.display = 'none';
        } else if (role === 'student') {
          identifierLabel.innerText = 'Student Email or Roll Number';
          inputField.placeholder = 'rahul@camp.com or 210001';
          inputField.value = '210001';
          passField.value = 'student123';
          if (selfRegBox) selfRegBox.style.display = 'block';
        }
      }
    </script>
</body>
</html>
