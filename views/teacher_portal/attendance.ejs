<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Teacher | Mark Attendance & AI Face Rec</title>
    <link rel="icon" type="image/png" href="/images/logo/camp-logo.png">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
</head>
<body class="bg-light">
    <nav class="navbar navbar-expand-lg navbar-dark bg-primary shadow-sm">
        <div class="container d-flex justify-content-between align-items-center">
            <div class="d-flex align-items-center">
                <a class="navbar-brand font-weight-bold me-3" href="/teacher/dashboard">
                    <i class="bi bi-arrow-left me-2"></i> Teacher Portal
                </a>
                <span class="navbar-text text-white d-none d-md-inline">Mark Class Attendance</span>
            </div>
            <a href="/logout" class="btn btn-outline-light btn-sm"><i class="bi bi-box-arrow-right me-1"></i> Logout</a>
        </div>
    </nav>

    <div class="container py-4">
        <% if (messages && messages.success) { %>
            <div class="alert alert-success alert-dismissible fade show"><%= messages.success %><button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
        <% } %>
        <% if (messages && messages.warning) { %>
            <div class="alert alert-warning alert-dismissible fade show"><%= messages.warning %><button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
        <% } %>

        <div class="row g-4 mb-4">
            <!-- Manual Attendance Card -->
            <div class="col-lg-7">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-body">
                        <h4 class="card-title"><i class="bi bi-pencil-square text-primary me-2"></i> Mark Manual Attendance</h4>
                        <form action="/teacher/attendance/mark" method="POST" class="mt-3">
                            <div class="row g-3">
                                <div class="col-md-6">
                                    <label class="form-label">Student</label>
                                    <select name="student_id" class="form-select" required>
                                        <option value="">-- Select Student --</option>
                                        <% students.forEach(s => { %>
                                            <option value="<%= s.student_id %>"><%= s.name %> (<%= s.university_roll_number %>)</option>
                                        <% }) %>
                                    </select>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label">Subject</label>
                                    <select name="subject_code" class="form-select" required>
                                        <% subjects.forEach(sub => { %>
                                            <option value="<%= sub.code %>"><%= sub.name %> (<%= sub.code %>)</option>
                                        <% }) %>
                                    </select>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label">Status</label>
                                    <select name="status" class="form-select">
                                        <option value="Present" selected>Present</option>
                                        <option value="Absent">Absent</option>
                                        <option value="Late">Late</option>
                                    </select>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label">Teacher Remarks</label>
                                    <input type="text" name="remarks" class="form-control" placeholder="e.g. Verified in lab">
                                </div>
                                <div class="col-12 text-end mt-3">
                                    <button type="submit" class="btn btn-primary px-4"><i class="bi bi-check-lg me-1"></i> Save Attendance</button>
                                </div>
                            </div>
                        </form>
                    </div>
                </div>
            </div>

            <!-- AI Face Recognition Scanner Card -->
            <div class="col-lg-5">
                <div class="card border-0 shadow-sm bg-white p-4 h-100 d-flex flex-column justify-content-between">
                    <div>
                        <div class="d-flex align-items-center justify-content-between mb-2">
                            <h4 class="mb-0"><i class="bi bi-person-bounding-box text-primary me-2"></i> AI Face Attendance</h4>
                            <span class="badge bg-success-subtle text-success px-2 py-1"><i class="bi bi-camera-fill me-1"></i> WebCam Scanner</span>
                        </div>
                        <p class="text-muted small mb-3">Scan student face using camera. System will match against saved student face photos and mark attendance automatically.</p>

                        <!-- Camera Preview Box -->
                        <div class="position-relative bg-dark rounded-3 overflow-hidden mb-3 text-center" style="min-height: 220px;">
                            <video id="teacherWebcamVideo" style="width: 100%; max-height: 220px; border-radius: 8px; transform: scaleX(-1);" autoplay playsinline></video>
                            <canvas id="teacherCanvas" style="display:none;"></canvas>
                            <div id="teacherScanOverlay" class="position-absolute top-50 start-50 translate-middle border border-2 border-primary rounded-circle" style="width: 130px; height: 160px; pointer-events: none; border-style: dashed !important; box-shadow: 0 0 0 9999px rgba(0,0,0,0.3);"></div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label small font-weight-bold">Select Class Subject</label>
                            <select id="teacherSubjectCode" class="form-select form-select-sm">
                                <% subjects.forEach(sub => { %>
                                    <option value="<%= sub.code %>"><%= sub.name %> (<%= sub.code %>)</option>
                                <% }) %>
                            </select>
                        </div>

                        <div id="scanStatusAlert" class="alert alert-info py-2 small text-center mb-3">
                            <i class="bi bi-info-circle me-1"></i> WebCam scanner ready. Click Scan Face.
                        </div>
                    </div>

                    <div>
                        <button type="button" id="startScanBtn" class="btn btn-primary btn-lg w-100 mb-2">
                            <i class="bi bi-camera-fill me-2"></i> Scan Face & Mark Attendance
                        </button>

                        <form action="/teacher/attendance/trigger-face-rec" method="POST" class="mt-2 text-center">
                            <button type="submit" class="btn btn-link btn-sm text-decoration-none text-muted">
                                <i class="bi bi-window me-1"></i> Or Launch OpenCV Python Window
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        </div>

        <!-- Class Logs Table -->
        <div class="card border-0 shadow-sm">
            <div class="card-body">
                <h5><i class="bi bi-journal-text me-2"></i> Class Attendance Logs for Date: <%= filterDate %></h5>
                <div class="table-responsive mt-3">
                    <table class="table table-hover align-middle">
                        <thead>
                            <tr>
                                <th>Roll No</th>
                                <th>Student Name</th>
                                <th>Subject</th>
                                <th>Time</th>
                                <th>Mode</th>
                                <th>Status</th>
                                <th>Marked By</th>
                            </tr>
                        </thead>
                        <tbody id="attendanceLogsTableBody">
                            <% if (attendanceLogs && attendanceLogs.length > 0) { %>
                                <% attendanceLogs.forEach(log => { %>
                                    <tr>
                                        <td><strong><%= log.university_roll_number %></strong></td>
                                        <td><%= log.student_name %></td>
                                        <td><span class="badge bg-secondary"><%= log.subject_code %></span></td>
                                        <td><%= log.time %></td>
                                        <td><span class="badge bg-info text-dark"><%= log.verification_mode %></span></td>
                                        <td><span class="badge bg-<%= log.status === 'Present' ? 'success' : (log.status === 'Late' ? 'warning text-dark' : 'danger') %>"><%= log.status %></span></td>
                                        <td><small class="text-muted"><%= log.marked_by %></small></td>
                                    </tr>
                                <% }) %>
                            <% } else { %>
                                <tr><td colspan="7" class="text-center text-muted">No attendance marked for today yet.</td></tr>
                            <% } %>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <script>
        const teacherVideo = document.getElementById('teacherWebcamVideo');
        const teacherCanvas = document.getElementById('teacherCanvas');
        const startScanBtn = document.getElementById('startScanBtn');
        const scanStatusAlert = document.getElementById('scanStatusAlert');
        const teacherSubjectCode = document.getElementById('teacherSubjectCode');

        async function initTeacherCamera() {
            try {
                const stream = await navigator.mediaDevices.getUserMedia({ video: { width: 480, height: 360, facingMode: "user" } });
                teacherVideo.srcObject = stream;
            } catch (err) {
                console.error("Camera error:", err);
                scanStatusAlert.className = 'alert alert-warning py-2 small text-center mb-3';
                scanStatusAlert.innerHTML = '<i class="bi bi-exclamation-triangle me-1"></i> WebCam unavailable. Please check camera permissions.';
            }
        }

        startScanBtn.addEventListener('click', async () => {
            if (!teacherVideo.srcObject) {
                await initTeacherCamera();
                if (!teacherVideo.srcObject) return;
            }

            const ctx = teacherCanvas.getContext('2d');
            teacherCanvas.width = teacherVideo.videoWidth || 480;
            teacherCanvas.height = teacherVideo.videoHeight || 360;

            ctx.translate(teacherCanvas.width, 0);
            ctx.scale(-1, 1);
            ctx.drawImage(teacherVideo, 0, 0, teacherCanvas.width, teacherCanvas.height);

            const photoDataUrl = teacherCanvas.toDataURL('image/jpeg', 0.9);

            scanStatusAlert.className = 'alert alert-info py-2 small text-center mb-3';
            scanStatusAlert.innerHTML = '<i class="bi bi-hourglass-split me-1"></i> Matching face against registered student photos...';
            startScanBtn.disabled = true;

            try {
                const response = await fetch('/teacher/api/scan-and-match-face', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        photo_data: photoDataUrl,
                        subject_code: teacherSubjectCode.value
                    })
                });

                const data = await response.json();
                if (data.success) {
                    scanStatusAlert.className = 'alert alert-success py-2 small text-center mb-3';
                    scanStatusAlert.innerHTML = `<i class="bi bi-check-circle-fill me-1"></i> ${data.message}`;
                    setTimeout(() => window.location.reload(), 1500);
                } else {
                    scanStatusAlert.className = 'alert alert-danger py-2 small text-center mb-3';
                    scanStatusAlert.innerHTML = `<i class="bi bi-x-circle-fill me-1"></i> ${data.message}`;
                }
            } catch (err) {
                scanStatusAlert.className = 'alert alert-danger py-2 small text-center mb-3';
                scanStatusAlert.innerHTML = '<i class="bi bi-x-circle-fill me-1"></i> Network error matching face.';
            } finally {
                startScanBtn.disabled = false;
            }
        });

        window.addEventListener('DOMContentLoaded', initTeacherCamera);
    </script>
</body>
</html>
