<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Teacher Portal | CAMP ERP</title>
    <link rel="icon" type="image/png" href="/images/logo/camp-logo.png">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="/css/base/variables.css">
    <link rel="stylesheet" href="/css/base/base.css">
    <link rel="stylesheet" href="/css/components/cards.css">
    <link rel="stylesheet" href="/css/components/buttons.css">
</head>
<body class="bg-light">
    <nav class="navbar navbar-expand-lg navbar-dark bg-primary shadow-sm">
        <div class="container">
            <a class="navbar-brand font-weight-bold" href="/teacher/dashboard">
                <i class="bi bi-person-workspace me-2"></i> CAMP Teacher Portal
            </a>
            <div class="d-flex align-items-center text-white">
                <span class="me-3">Welcome, <strong><%= teacherName %></strong></span>
                <a href="/logout" class="btn btn-outline-light btn-sm"><i class="bi bi-box-arrow-right me-1"></i> Logout</a>
            </div>
        </div>
    </nav>

    <div class="container py-4">
        <% if (messages && messages.success) { %>
            <div class="alert alert-success alert-dismissible fade show"><%= messages.success %><button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
        <% } %>
        <% if (messages && messages.warning) { %>
            <div class="alert alert-warning alert-dismissible fade show"><%= messages.warning %><button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
        <% } %>

        <div class="card border-0 shadow-sm mb-4">
            <div class="card-body bg-white rounded p-4">
                <h2>👨‍🏫 Faculty Control Center</h2>
                <p class="text-muted">Manage class attendance, view real-time statistics, and update student attendance reports.</p>
            </div>
        </div>

        <div class="row g-4 mb-4">
            <div class="col-md-6">
                <div class="card border-0 shadow-sm text-center p-4">
                    <i class="bi bi-people-fill text-primary display-4 mb-2"></i>
                    <h5>Total Students Enrolled</h5>
                    <h2><%= stats.students %></h2>
                </div>
            </div>
            <div class="col-md-6">
                <div class="card border-0 shadow-sm text-center p-4">
                    <i class="bi bi-person-check-fill text-success display-4 mb-2"></i>
                    <h5>Today's Total Attendance</h5>
                    <h2><%= stats.todayAttendance %></h2>
                </div>
            </div>
        </div>

        <div class="row g-4">
            <div class="col-md-4">
                <div class="card border-0 shadow-sm text-center p-4 h-100">
                    <i class="bi bi-camera-video-fill text-primary display-5 mb-2"></i>
                    <h4>Mark Attendance</h4>
                    <p class="text-muted small">Mark manual class attendance or launch camera recognition.</p>
                    <a href="/teacher/attendance" class="btn btn-primary mt-auto"><i class="bi bi-check2-square me-1"></i> Take Attendance</a>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card border-0 shadow-sm text-center p-4 h-100">
                    <i class="bi bi-file-earmark-spreadsheet-fill text-success display-5 mb-2"></i>
                    <h4>Student Reports</h4>
                    <p class="text-muted small">View, edit, and update student attendance reports & status.</p>
                    <a href="/teacher/reports" class="btn btn-success mt-auto"><i class="bi bi-journal-text me-1"></i> Edit Reports</a>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card border-0 shadow-sm text-center p-4 h-100">
                    <i class="bi bi-qr-code-scan text-warning display-5 mb-2"></i>
                    <h4>QR Verification Session</h4>
                    <p class="text-muted small">Generate classroom session QR code for student self-scanning.</p>
                    <a href="/qr" class="btn btn-warning text-dark mt-auto"><i class="bi bi-qr-code me-1"></i> Open QR Session</a>
                </div>
            </div>
        </div>
    </div>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
