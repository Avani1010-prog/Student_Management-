<%- include('../components/header.ejs') %>
<%- include('../components/sidebar.ejs') %>

<div class="main-wrapper">
  <%- include('../components/navbar.ejs') %>

  <main class="content">
    <% if (messages && messages.success) { %>
      <div class="alert alert-success alert-dismissible fade show mb-4"><%= messages.success %><button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
    <% } %>
    <% if (messages && messages.warning) { %>
      <div class="alert alert-warning alert-dismissible fade show mb-4"><%= messages.warning %><button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
    <% } %>

    <div class="student-header mb-4">
      <div class="header-info">
        <h2>Attendance Management</h2>
        <p>Mark student attendance manually, view log history, or trigger AI Face Recognition (Version 0.8 & 0.9).</p>
      </div>
    </div>

    <!-- Action Cards -->
    <div class="row g-4 mb-4">
      <!-- Manual Mark Card -->
      <div class="col-lg-7">
        <div class="erp-card">
          <h4><i class="bi bi-pencil-square text-primary me-2"></i> Mark Manual Attendance</h4>
          <form action="/attendance/mark" method="POST" class="mt-3">
            <div class="row g-3">
              <div class="col-md-6">
                <label class="form-label">Select Student</label>
                <select name="student_id" class="form-select" required>
                  <option value="">-- Choose Student --</option>
                  <% students.forEach(student => { %>
                    <option value="<%= student.student_id %>"><%= student.name %> (<%= student.university_roll_number %>)</option>
                  <% }) %>
                </select>
              </div>
              <div class="col-md-6">
                <label class="form-label">Subject</label>
                <select name="subject_code" class="form-select" required>
                  <% subjects.forEach(sub => { %>
                    <option value="<%= sub.code %>"><%= sub.name %> (<%= sub.code %>)</option>
                  <% }) %>
                </select>
              </div>
              <div class="col-md-6">
                <label class="form-label">Status</label>
                <select name="status" class="form-select">
                  <option value="Present" selected>Present</option>
                  <option value="Absent">Absent</option>
                  <option value="Late">Late</option>
                </select>
              </div>
              <div class="col-md-6 d-flex align-items-end">
                <button type="submit" class="btn-primary-custom w-100"><i class="bi bi-check-circle me-1"></i> Mark Attendance</button>
              </div>
            </div>
          </form>
        </div>
      </div>

      <!-- AI Face Rec WebCam Card (Works on Cloud & Local) -->
      <div class="col-lg-5">
        <div class="erp-card bg-white border shadow-sm p-4 h-100 d-flex flex-column justify-content-between">
          <div>
            <div class="d-flex align-items-center justify-content-between mb-2">
              <h4 class="mb-0"><i class="bi bi-person-bounding-box text-primary me-2"></i> Face Attendance</h4>
              <span class="badge bg-success-subtle text-success px-2 py-1"><i class="bi bi-camera-fill me-1"></i> Live WebCam</span>
            </div>
            <p class="text-muted small mb-3">Live camera face detection. Works on Mobile, Laptop & Cloud Deployed URLs.</p>

            <!-- Camera Preview Box -->
            <div class="position-relative bg-dark rounded-3 overflow-hidden mb-3 text-center" style="min-height: 220px;">
              <video id="adminWebcamVideo" style="width: 100%; max-height: 220px; border-radius: 8px; transform: scaleX(-1);" autoplay playsinline muted></video>
              <canvas id="adminCanvas" style="display:none;"></canvas>
              <div id="adminScanOverlay" class="position-absolute top-50 start-50 translate-middle border border-2 border-primary rounded-circle" style="width: 130px; height: 160px; pointer-events: none; border-style: dashed !important; box-shadow: 0 0 0 9999px rgba(0,0,0,0.3);"></div>
            </div>

            <div class="mb-3">
              <label class="form-label small fw-bold">Select Subject for Attendance</label>
              <select id="adminSubjectCode" class="form-select form-select-sm">
                <% subjects.forEach(sub => { %>
                  <option value="<%= sub.code %>"><%= sub.name %> (<%= sub.code %>)</option>
                <% }) %>
              </select>
            </div>

            <div id="adminScanStatusAlert" class="alert alert-info py-2 small text-center mb-3">
              <i class="bi bi-info-circle me-1"></i> WebCam ready. Position face inside circle & click Scan.
            </div>
          </div>

          <div>
            <button type="button" id="adminStartScanBtn" class="btn btn-primary btn-lg w-100 mb-2">
              <i class="bi bi-camera-fill me-2"></i> Scan Face & Mark Attendance
            </button>

            <form action="/attendance/trigger-face-rec" method="POST" class="mt-2 text-center">
              <button type="submit" class="btn btn-link btn-sm text-decoration-none text-muted">
                <i class="bi bi-window me-1"></i> Or Launch OpenCV Python Window (Local Only)
              </button>
            </form>
          </div>
        </div>
      </div>
    </div>

    <!-- Attendance Logs Section -->
    <div class="erp-card">
      <div class="d-flex justify-content-between align-items-center mb-3">
        <h4><i class="bi bi-journal-text me-2"></i> Attendance Log Records</h4>
        <form action="/attendance" method="GET" class="d-flex gap-2">
          <input type="date" name="date" class="form-control form-control-sm" value="<%= filterDate %>" onchange="this.form.submit()">
        </form>
      </div>

      <div class="table-responsive">
        <table class="table table-hover align-middle">
          <thead>
            <tr>
              <th>ID</th>
              <th>Roll Number</th>
              <th>Student Name</th>
              <th>Subject</th>
              <th>Date</th>
              <th>Time</th>
              <th>Verification Mode</th>
              <th>Status</th>
            </tr>
          </thead>
          <tbody>
            <% if (attendanceLogs && attendanceLogs.length > 0) { %>
              <% attendanceLogs.forEach(log => { %>
                <tr>
                  <td>#<%= log.id %></td>
                  <td><strong><%= log.university_roll_number %></strong></td>
                  <td><%= log.student_name %></td>
                  <td><span class="badge bg-secondary"><%= log.subject_code %></span></td>
                  <td><%= log.date %></td>
                  <td><%= log.time %></td>
                  <td>
                    <span class="badge <%= log.verification_mode === 'AI Face Rec' ? 'bg-info text-dark' : (log.verification_mode === 'QR Code' ? 'bg-success' : 'bg-primary') %>">
                      <%= log.verification_mode %>
                    </span>
                  </td>
                  <td><span class="badge bg-success">Present</span></td>
                </tr>
              <% }) %>
            <% } else { %>
              <tr>
                <td colspan="8" class="text-center py-4 text-muted">No attendance marked for date <%= filterDate %>.</td>
              </tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>
  </main>

  <script>
    const adminVideo = document.getElementById('adminWebcamVideo');
    const adminCanvas = document.getElementById('adminCanvas');
    const adminStartScanBtn = document.getElementById('adminStartScanBtn');
    const adminScanStatusAlert = document.getElementById('adminScanStatusAlert');
    const adminSubjectCode = document.getElementById('adminSubjectCode');

    async function initAdminCamera() {
      try {
        const stream = await navigator.mediaDevices.getUserMedia({
          video: { width: 480, height: 360, facingMode: "user" }
        });
        adminVideo.srcObject = stream;
      } catch (err) {
        console.error("Admin Camera error:", err);
        adminScanStatusAlert.className = 'alert alert-warning py-2 small text-center mb-3';
        adminScanStatusAlert.innerHTML = '<i class="bi bi-exclamation-triangle me-1"></i> WebCam unavailable. Please allow camera permissions in browser.';
      }
    }

    if (adminStartScanBtn) {
      adminStartScanBtn.addEventListener('click', async () => {
        if (!adminVideo.srcObject) {
          await initAdminCamera();
          if (!adminVideo.srcObject) return;
        }

        const ctx = adminCanvas.getContext('2d');
        adminCanvas.width = adminVideo.videoWidth || 480;
        adminCanvas.height = adminVideo.videoHeight || 360;

        ctx.translate(adminCanvas.width, 0);
        ctx.scale(-1, 1);
        ctx.drawImage(adminVideo, 0, 0, adminCanvas.width, adminCanvas.height);

        const photoDataUrl = adminCanvas.toDataURL('image/jpeg', 0.9);

        adminScanStatusAlert.className = 'alert alert-info py-2 small text-center mb-3';
        adminScanStatusAlert.innerHTML = '<i class="bi bi-hourglass-split me-1"></i> Scanning face & verifying student...';
        adminStartScanBtn.disabled = true;

        try {
          const response = await fetch('/attendance/api/scan-and-match-face', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              photo_data: photoDataUrl,
              subject_code: adminSubjectCode ? adminSubjectCode.value : 'GEN'
            })
          });

          const data = await response.json();
          if (data.success) {
            adminScanStatusAlert.className = 'alert alert-success py-2 small text-center mb-3';
            adminScanStatusAlert.innerHTML = `<i class="bi bi-check-circle-fill me-1"></i> ${data.message}`;
            setTimeout(() => window.location.reload(), 1500);
          } else {
            adminScanStatusAlert.className = 'alert alert-danger py-2 small text-center mb-3';
            adminScanStatusAlert.innerHTML = `<i class="bi bi-x-circle-fill me-1"></i> ${data.message}`;
          }
        } catch (err) {
          adminScanStatusAlert.className = 'alert alert-danger py-2 small text-center mb-3';
          adminScanStatusAlert.innerHTML = '<i class="bi bi-x-circle-fill me-1"></i> Network error matching face.';
        } finally {
          adminStartScanBtn.disabled = false;
        }
      });
    }

    window.addEventListener('DOMContentLoaded', initAdminCamera);
  </script>

  <%- include('../components/footer.ejs') %>
</div>
