<%- include('../components/header.ejs') %>
<%- include('../components/sidebar.ejs') %>

<div class="main-wrapper">
  <%- include('../components/navbar.ejs') %>

  <main class="content">
    <% if (messages && messages.success) { %>
      <div class="alert alert-success alert-dismissible fade show mb-4"><%= messages.success %><button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
    <% } %>
    <% if (messages && messages.warning) { %>
      <div class="alert alert-warning alert-dismissible fade show mb-4"><%= messages.warning %><button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
    <% } %>

    <div class="student-header">
      <div class="header-info">
        <h2>Students</h2>
        <p>Manage student records and academic information.</p>
      </div>
      <div class="student-count">
        <i class="bi bi-people-fill"></i>
        <strong><%= student_count %></strong> Students
      </div>
    </div>

    <!-- Search Bar -->
    <div class="erp-card action-bar">
      <div class="row g-3 align-items-center">
        <div class="col-lg-6 col-md-5">
          <div class="search-box">
            <i class="bi bi-search"></i>
            <input type="text" id="searchStudent" placeholder="Search by roll no, name..." />
          </div>
        </div>
        <div class="col-lg-6 col-md-7 text-md-end d-flex justify-content-md-end gap-2 flex-wrap">
          <a href="/student/self-register" target="_blank" class="btn btn-outline-primary">
            <i class="bi bi-camera-fill me-1"></i> Self-Register & Face ID Link
          </a>
          <a href="/register" class="btn-primary-custom add-btn">
            <i class="bi bi-plus-circle"></i> Add Student
          </a>
        </div>
      </div>
    </div>

    <div class="erp-card">
      <div class="table-responsive">
        <table class="student-table">
          <thead>
            <tr class="student-row">
              <th class="col-roll">Roll No</th>
              <th class="col-name">Name</th>
              <th class="col-program">Branch</th>
              <th class="col-year">Year</th>
              <th class="col-section">Section</th>
              <th class="col-face text-center">Face ID</th>
              <th class="col-attendance text-center">Total Attendance</th>
              <th class="col-actions text-center">Actions</th>
            </tr>
          </thead>
          <tbody>
            <% if (students && students.length > 0) { %>
              <% students.forEach(student => { %>
                <tr class="student-row"
                    data-student-id="<%= student.student_id %>"
                    data-name="<%= student.name %>"
                    data-university-roll-number="<%= student.university_roll_number %>"
                    data-branch="<%= student.branch %>"
                    data-year="<%= student.year %>"
                    data-section="<%= student.section %>"
                    data-email="<%= student.email %>"
                    data-phone="<%= student.phone %>"
                    data-total-classes="<%= student.total_classes || 0 %>"
                    data-total-present="<%= student.total_present || 0 %>"
                    data-total-absent="<%= student.total_absent || 0 %>"
                    data-total-late="<%= student.total_late || 0 %>"
                    data-attendance-percentage="<%= student.attendance_percentage || 100 %>">
                  <td class="col-roll"><%= student.university_roll_number %></td>
                  <td class="col-name"><%= student.name %></td>
                  <td class="col-program"><%= student.branch %></td>
                  <td class="col-year"><%= student.year %></td>
                  <td class="col-section"><%= student.section %></td>
                  <td class="col-face text-center">
                    <% if (student.face_registered || (student.photo_url && student.photo_url !== '')) { %>
                      <span class="badge bg-success-subtle text-success px-2 py-1"><i class="bi bi-person-check-fill me-1"></i> Registered</span>
                    <% } else { %>
                      <span class="badge bg-warning-subtle text-dark px-2 py-1"><i class="bi bi-exclamation-circle me-1"></i> Pending</span>
                    <% } %>
                  </td>
                  <td class="col-attendance text-center">
                    <% const pct = student.attendance_percentage || 100; %>
                    <span class="badge bg-<%= pct >= 75 ? 'success' : (pct >= 50 ? 'warning text-dark' : 'danger') %> px-2 py-1">
                      <%= student.total_present || 0 %> / <%= student.total_classes || 0 %> (<%= pct %>%)
                    </span>
                  </td>
                  <td class="col-actions">
                    <div class="action-buttons">
                      <button class="btn-register-face btn btn-sm btn-outline-success" title="Register / Capture Face ID" data-bs-toggle="modal" data-bs-target="#faceRegisterModal"
                              data-id="<%= student.student_id %>"
                              data-name="<%= student.name %>"
                              data-roll="<%= student.university_roll_number %>"><i class="bi bi-camera-fill"></i></button>
                      <button class="btn-view" title="View Student" data-bs-toggle="modal" data-bs-target="#viewStudentModal"><i class="bi bi-eye-fill"></i></button>
                      <button class="btn-edit" title="Edit Student" data-bs-toggle="modal" data-bs-target="#editStudentModal"
                              data-id="<%= student.student_id %>"
                              data-name="<%= student.name %>"
                              data-university-roll-number="<%= student.university_roll_number %>"
                              data-branch="<%= student.branch %>"
                              data-year="<%= student.year %>"
                              data-section="<%= student.section %>"
                              data-email="<%= student.email %>"
                              data-phone="<%= student.phone %>"><i class="bi bi-pencil-square"></i></button>
                      <button class="btn-delete" title="Delete Student" data-bs-toggle="modal" data-bs-target="#deleteStudentModal"
                              data-id="<%= student.student_id %>"
                              data-name="<%= student.name %>"
                              data-university-roll-number="<%= student.university_roll_number %>"><i class="bi bi-trash"></i></button>
                    </div>
                  </td>
                </tr>
              <% }) %>
            <% } else { %>
              <tr class="student-row">
                <td colspan="8" class="empty-state">
                  <i class="bi bi-people"></i>
                  <h4>No Students Found</h4>
                  <p>Click <strong>Add Student</strong> or <strong>Self-Register Link</strong> to add students.</p>
                </td>
              </tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>
  </main>

  <%- include('../components/footer.ejs') %>
</div>

<!-- Register Face Modal -->
<div class="modal fade" id="faceRegisterModal" tabindex="-1">
  <div class="modal-dialog modal-md">
    <div class="modal-content">
      <form method="POST" action="/student/register-face-admin">
        <div class="modal-header bg-success text-white">
          <h5 class="modal-title"><i class="bi bi-camera-fill me-2"></i> Register Student Face ID</h5>
          <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
        </div>
        <div class="modal-body text-center">
          <input type="hidden" id="faceModalStudentId" name="student_id" />
          <input type="hidden" id="faceModalPhotoData" name="photo_data" />

          <p class="mb-2"><strong>Student:</strong> <span id="faceModalStudentName"></span> (<span id="faceModalStudentRoll"></span>)</p>

          <div class="position-relative bg-dark rounded-3 overflow-hidden mb-3" style="min-height: 250px;">
            <video id="adminWebcamVideo" style="width: 100%; max-height: 250px;" autoplay playsinline></video>
            <canvas id="adminCanvas" style="display:none;"></canvas>
          </div>

          <div id="adminFacePreview" class="d-none mb-3">
            <p class="text-success font-weight-bold mb-1"><i class="bi bi-check-circle-fill"></i> Snapshot Captured!</p>
            <img id="adminFacePreviewImg" style="max-width: 160px; border-radius: 8px; border: 2px solid #198754;" />
          </div>

          <div class="btn-group w-100">
            <button type="button" id="adminSnapBtn" class="btn btn-success"><i class="bi bi-camera-fill me-1"></i> Capture Photo</button>
            <button type="button" id="adminRetakeBtn" class="btn btn-outline-secondary d-none"><i class="bi bi-arrow-counterclockwise me-1"></i> Retake</button>
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
          <button type="submit" class="btn btn-success" id="adminSaveFaceBtn" disabled><i class="bi bi-check-lg me-1"></i> Save Face ID</button>
        </div>
      </form>
    </div>
  </div>
</div>

<!-- View Modal -->
<div class="modal fade" id="viewStudentModal" tabindex="-1">
  <div class="modal-dialog modal-lg">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title"><i class="bi bi-person-vcard-fill"></i> Student Details & Attendance Summary</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body">
        <table class="table table-borderless">
          <tr><th width="220">University Roll Number</th><td id="viewUniversityRollNumber"></td></tr>
          <tr><th>Student Name</th><td id="viewName"></td></tr>
          <tr><th>Branch</th><td id="viewBranch"></td></tr>
          <tr><th>Year</th><td id="viewYear"></td></tr>
          <tr><th>Section</th><td id="viewSection"></td></tr>
          <tr><th>Email</th><td id="viewEmail"></td></tr>
          <tr><th>Phone</th><td id="viewPhone"></td></tr>
          <tr><th>Total Classes Logged</th><td id="viewTotalClasses"></td></tr>
          <tr><th>Total Present</th><td id="viewTotalPresent" class="text-success font-weight-bold"></td></tr>
          <tr><th>Total Absent</th><td id="viewTotalAbsent" class="text-danger"></td></tr>
          <tr><th>Overall Attendance Rate</th><td><span id="viewAttendancePercentage" class="badge fs-6"></span></td></tr>
        </table>
      </div>
      <div class="modal-footer"><button class="btn btn-secondary" data-bs-dismiss="modal">Close</button></div>
    </div>
  </div>
</div>

<!-- Edit Modal -->
<div class="modal fade" id="editStudentModal" tabindex="-1">
  <div class="modal-dialog modal-lg">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title"><i class="bi bi-pencil-square"></i> Edit Student</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <form method="POST" action="/update-student">
        <div class="modal-body">
          <div class="row g-3">
            <input type="hidden" id="editStudentId" name="student_id" />
            <div class="col-md-6"><label>Name</label><input type="text" id="editName" name="name" class="form-control" required /></div>
            <div class="col-md-6"><label>University Roll Number</label><input type="text" id="editUniversityRollNumber" name="university_roll_number" class="form-control" readonly /></div>
            <div class="col-md-6"><label>Branch</label><input type="text" id="editBranch" class="form-control" name="branch" required /></div>
            <div class="col-md-6"><label>Year</label><input type="text" id="editYear" class="form-control" name="year" required /></div>
            <div class="col-md-6"><label>Section</label><input type="text" id="editSection" class="form-control" name="section" required /></div>
            <div class="col-md-6"><label>Email</label><input type="email" id="editEmail" class="form-control" name="email" required /></div>
            <div class="col-md-12"><label>Phone</label><input type="text" id="editPhone" class="form-control" name="phone" required /></div>
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
          <button type="submit" class="btn-primary-custom">Save Changes</button>
        </div>
      </form>
    </div>
  </div>
</div>

<!-- Delete Modal -->
<div class="modal fade" id="deleteStudentModal" tabindex="-1">
  <div class="modal-dialog">
    <div class="modal-content">
      <form method="POST" action="/delete-student">
        <div class="modal-header bg-danger text-white">
          <h5 class="modal-title"><i class="bi bi-trash-fill"></i> Delete Student</h5>
          <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
        </div>
        <div class="modal-body">
          <input type="hidden" id="deleteStudentId" name="student_id" />
          <p>Are you sure you want to permanently delete this student?</p>
          <div class="alert alert-warning">
            <strong>Name:</strong> <span id="deleteStudentName"></span><br />
            <strong>University Roll Number:</strong> <span id="deleteUniversityRollNumber"></span>
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
          <button type="submit" class="btn btn-danger">Delete Student</button>
        </div>
      </form>
    </div>
  </div>
</div>

<script src="/js/students.js"></script>
