<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Student Self-Registration | CAMP ERP</title>
    <link rel="icon" type="image/png" href="/images/logo/camp-logo.png">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    
    <link rel="stylesheet" href="/css/base/variables.css">
    <link rel="stylesheet" href="/css/base/base.css">
    <link rel="stylesheet" href="/css/base/typography.css">
    <link rel="stylesheet" href="/css/components/buttons.css">
    <link rel="stylesheet" href="/css/components/forms.css">
    <link rel="stylesheet" href="/css/components/cards.css">
    <style>
        body { background: #f4f6f9; min-height: 100vh; }
        .self-reg-nav { background: #0f172a; border-bottom: 3px solid #3b82f6; }
        .camera-box {
            position: relative;
            background: #000;
            border-radius: 16px;
            overflow: hidden;
            border: 3px solid #3b82f6;
            min-height: 280px;
            display: flex;
            align-items: center;
            justify-content: center;
        }
        #webcamVideo { width: 100%; height: auto; display: block; border-radius: 12px; transform: scaleX(-1); }
        #capturedCanvas { display: none; }
        .face-overlay {
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            width: 180px;
            height: 220px;
            border: 2px dashed rgba(59, 130, 246, 0.8);
            border-radius: 50%;
            pointer-events: none;
            box-shadow: 0 0 0 9999px rgba(0, 0, 0, 0.35);
        }
        .captured-preview-img {
            max-width: 180px;
            border-radius: 12px;
            border: 3px solid #10b981;
            box-shadow: 0 4px 12px rgba(16, 185, 129, 0.3);
        }
    </style>
</head>
<body>

    <!-- Header Navigation -->
    <nav class="navbar navbar-dark self-reg-nav shadow-sm mb-4">
        <div class="container d-flex justify-content-between align-items-center">
            <a class="navbar-brand font-weight-bold d-flex align-items-center text-white" href="/login">
                <i class="bi bi-mortarboard-fill text-primary display-6 me-2"></i>
                <div>
                    <h4 class="mb-0 text-white font-weight-bold">CAMP ERP</h4>
                    <small class="text-muted" style="font-size: 0.75rem;">Student Self-Registration Portal</small>
                </div>
            </a>
            <a href="/login" class="btn btn-outline-light btn-sm"><i class="bi bi-arrow-left me-1"></i> Back to Login</a>
        </div>
    </nav>

    <div class="container pb-5">
        <% if (messages && messages.warning) { %>
            <div class="alert alert-warning alert-dismissible fade show mb-4"><i class="bi bi-exclamation-triangle-fill me-2"></i><%= messages.warning %><button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
        <% } %>
        <% if (messages && messages.success) { %>
            <div class="alert alert-success alert-dismissible fade show mb-4"><i class="bi bi-check-circle-fill me-2"></i><%= messages.success %><button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
        <% } %>

        <div class="card border-0 shadow-sm p-4 rounded-4 bg-white">
            <div class="d-flex align-items-center justify-content-between border-bottom pb-3 mb-4">
                <div>
                    <h3 class="font-weight-bold text-dark mb-1"><i class="bi bi-person-badge-fill text-primary me-2"></i> Student Self Registration & Face ID</h3>
                    <p class="text-muted mb-0">Complete your academic registration and enroll your Face Recognition ID in one step.</p>
                </div>
                <span class="badge bg-primary-subtle text-primary px-3 py-2 rounded-pill"><i class="bi bi-camera-fill me-1"></i> AI Face Enabled</span>
            </div>

            <form action="/student/self-register" method="POST" id="selfRegisterForm">
                <input type="hidden" name="photo_data" id="photoDataInput" />

                <div class="row g-4">
                    <!-- Left Side: Student Details -->
                    <div class="col-lg-7">
                        <h5 class="text-dark font-weight-bold mb-3"><i class="bi bi-journal-text text-primary me-2"></i> 1. Academic & Contact Information</h5>
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label font-weight-bold">Full Name <span class="text-danger">*</span></label>
                                <input type="text" name="name" class="form-control form-control-lg" placeholder="e.g. Rahul Sharma" required />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label font-weight-bold">University Roll Number <span class="text-danger">*</span></label>
                                <input type="text" name="university_roll_number" class="form-control form-control-lg" placeholder="e.g. 210001" required />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label font-weight-bold">Branch <span class="text-danger">*</span></label>
                                <select name="branch" class="form-select form-select-lg" required>
                                    <option value="CSE">CSE</option>
                                    <option value="ECE">ECE</option>
                                    <option value="ME">ME</option>
                                    <option value="CE">CE</option>
                                </select>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label font-weight-bold">Year <span class="text-danger">*</span></label>
                                <select name="year" class="form-select form-select-lg" required>
                                    <option value="1">1st Year</option>
                                    <option value="2">2nd Year</option>
                                    <option value="3" selected>3rd Year</option>
                                    <option value="4">4th Year</option>
                                </select>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label font-weight-bold">Section <span class="text-danger">*</span></label>
                                <input type="text" name="section" class="form-control form-control-lg" placeholder="e.g. A" value="A" required />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label font-weight-bold">Email Address <span class="text-danger">*</span></label>
                                <input type="email" name="email" class="form-control form-control-lg" placeholder="rahul@camp.com" required />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label font-weight-bold">Phone (10 Digits) <span class="text-danger">*</span></label>
                                <input type="text" name="phone" class="form-control form-control-lg" placeholder="9876543210" pattern="\d{10}" title="Must be 10 digits" required />
                            </div>
                            <div class="col-md-12">
                                <label class="form-label font-weight-bold">Account Password <span class="text-danger">*</span></label>
                                <input type="password" name="password" class="form-control form-control-lg" placeholder="Create portal login password" required />
                                <small class="text-muted">You will use your Roll Number / Email and this password to log in.</small>
                            </div>
                        </div>
                    </div>

                    <!-- Right Side: WebCam Face Recognition Capture -->
                    <div class="col-lg-5">
                        <div class="p-3 bg-light rounded-4 border">
                            <h5 class="text-dark font-weight-bold mb-3"><i class="bi bi-person-bounding-box text-success me-2"></i> 2. Face Recognition ID Capture</h5>
                            <p class="text-muted small mb-3">Align your face inside the circle and click <strong>Capture Face Photo</strong> to link your biometric face ID.</p>

                            <div class="camera-box mb-3">
                                <video id="webcamVideo" autoplay playsinline></video>
                                <div class="face-overlay" id="faceOverlay"></div>
                                <canvas id="capturedCanvas"></canvas>
                            </div>

                            <div class="text-center mb-3">
                                <div id="previewContainer" class="d-none mb-3">
                                    <p class="text-success font-weight-bold mb-1"><i class="bi bi-check-circle-fill"></i> Face Photo Captured!</p>
                                    <img id="previewImg" class="captured-preview-img" alt="Captured Face" />
                                </div>

                                <div class="btn-group w-100 mb-2">
                                    <button type="button" id="snapBtn" class="btn btn-success btn-lg"><i class="bi bi-camera-fill me-1"></i> Capture Face Photo</button>
                                    <button type="button" id="retakeBtn" class="btn btn-outline-secondary btn-lg d-none"><i class="bi bi-arrow-counterclockwise me-1"></i> Retake</button>
                                </div>

                                <div class="or-divider my-2 text-muted small">OR UPLOAD PHOTO FILE</div>
                                <input type="file" id="fileUploadInput" accept="image/*" class="form-control form-control-sm" />
                            </div>

                            <div id="cameraStatusMsg" class="alert alert-info text-center py-2 mb-0 small">
                                <i class="bi bi-info-circle me-1"></i> Initializing webcam hardware...
                            </div>
                        </div>
                    </div>
                </div>

                <hr class="my-4">

                <div class="d-flex justify-content-between align-items-center">
                    <a href="/login" class="btn btn-secondary btn-lg px-4"><i class="bi bi-x-circle me-1"></i> Cancel</a>
                    <button type="submit" class="btn btn-primary btn-lg px-5 font-weight-bold"><i class="bi bi-check-circle-fill me-2"></i> Submit & Register Account</button>
                </div>
            </form>
        </div>
    </div>

    <script>
        const video = document.getElementById('webcamVideo');
        const canvas = document.getElementById('capturedCanvas');
        const snapBtn = document.getElementById('snapBtn');
        const retakeBtn = document.getElementById('retakeBtn');
        const previewContainer = document.getElementById('previewContainer');
        const previewImg = document.getElementById('previewImg');
        const photoDataInput = document.getElementById('photoDataInput');
        const cameraStatusMsg = document.getElementById('cameraStatusMsg');
        const fileUploadInput = document.getElementById('fileUploadInput');

        let mediaStream = null;

        async function initCamera() {
            try {
                mediaStream = await navigator.mediaDevices.getUserMedia({ video: { width: 640, height: 480, facingMode: "user" } });
                video.srcObject = mediaStream;
                cameraStatusMsg.className = 'alert alert-success text-center py-2 mb-0 small';
                cameraStatusMsg.innerHTML = '<i class="bi bi-camera-video-fill me-1"></i> WebCam active. Look into camera and click Capture.';
            } catch (err) {
                console.error("Camera access error:", err);
                cameraStatusMsg.className = 'alert alert-warning text-center py-2 mb-0 small';
                cameraStatusMsg.innerHTML = '<i class="bi bi-exclamation-triangle-fill me-1"></i> WebCam access unavailable. Please upload a photo file instead.';
            }
        }

        snapBtn.addEventListener('click', () => {
            if (!video.srcObject) {
                alert('WebCam is not active. Please select a photo file below.');
                return;
            }

            const context = canvas.getContext('2d');
            canvas.width = video.videoWidth || 640;
            canvas.height = video.videoHeight || 480;

            // Flip horizontally for mirroring webcam
            context.translate(canvas.width, 0);
            context.scale(-1, 1);
            context.drawImage(video, 0, 0, canvas.width, canvas.height);

            const dataUrl = canvas.toDataURL('image/jpeg', 0.9);
            photoDataInput.value = dataUrl;
            previewImg.src = dataUrl;

            previewContainer.classList.remove('d-none');
            retakeBtn.classList.remove('d-none');
            snapBtn.classList.add('d-none');

            cameraStatusMsg.className = 'alert alert-success text-center py-2 mb-0 small';
            cameraStatusMsg.innerHTML = '<i class="bi bi-check2-circle me-1"></i> Face ID Snapshot captured! Ready to submit.';
        });

        retakeBtn.addEventListener('click', () => {
            photoDataInput.value = '';
            previewContainer.classList.add('d-none');
            retakeBtn.classList.add('d-none');
            snapBtn.classList.remove('d-none');

            cameraStatusMsg.className = 'alert alert-info text-center py-2 mb-0 small';
            cameraStatusMsg.innerHTML = '<i class="bi bi-camera-video-fill me-1"></i> Camera ready for new snapshot.';
        });

        fileUploadInput.addEventListener('change', (e) => {
            const file = e.target.files[0];
            if (file) {
                const reader = new FileReader();
                reader.onload = function(evt) {
                    photoDataInput.value = evt.target.result;
                    previewImg.src = evt.target.result;
                    previewContainer.classList.remove('d-none');
                    retakeBtn.classList.remove('d-none');
                    snapBtn.classList.add('d-none');
                    cameraStatusMsg.className = 'alert alert-success text-center py-2 mb-0 small';
                    cameraStatusMsg.innerHTML = '<i class="bi bi-file-earmark-image-fill me-1"></i> Photo file uploaded & attached to registration.';
                };
                reader.readAsDataURL(file);
            }
        });

        window.addEventListener('DOMContentLoaded', initCamera);
    </script>
</body>
</html>
