<%- include('../components/header.ejs') %>
<%- include('../components/sidebar.ejs') %>

<div class="main-wrapper">
  <%- include('../components/navbar.ejs') %>

  <main class="content">
    <% if (messages && messages.success) { %>
      <div class="alert alert-success alert-dismissible fade show mb-4"><%= messages.success %><button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
    <% } %>
    <% if (messages && messages.warning) { %>
      <div class="alert alert-warning alert-dismissible fade show mb-4"><%= messages.warning %><button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
    <% } %>

    <div class="student-header mb-4">
      <div class="header-info">
        <h2>Subjects & Departments</h2>
        <p>Manage college academic departments, course subjects, and credits (Version 0.7 ERP Module).</p>
      </div>
    </div>

    <div class="row g-4">
      <!-- Departments Section -->
      <div class="col-lg-6">
        <div class="erp-card h-100">
          <div class="d-flex justify-content-between align-items-center mb-3">
            <h4><i class="bi bi-building text-primary me-2"></i> Departments</h4>
            <button class="btn-primary-custom btn-sm" data-bs-toggle="modal" data-bs-target="#addDepartmentModal">
              <i class="bi bi-plus-lg"></i> Add Department
            </button>
          </div>
          <div class="table-responsive">
            <table class="table table-hover align-middle">
              <thead>
                <tr>
                  <th>Code</th>
                  <th>Department Name</th>
                  <th>HOD</th>
                  <th class="text-end">Action</th>
                </tr>
              </thead>
              <tbody>
                <% if (departments && departments.length > 0) { %>
                  <% departments.forEach(dept => { %>
                    <tr>
                      <td><span class="badge bg-primary"><%= dept.code %></span></td>
                      <td><%= dept.name %></td>
                      <td><%= dept.head_name %></td>
                      <td class="text-end">
                        <form action="/departments/delete" method="POST" style="display:inline;" onsubmit="return confirm('Delete department?');">
                          <input type="hidden" name="id" value="<%= dept.id %>">
                          <button class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></button>
                        </form>
                      </td>
                    </tr>
                  <% }) %>
                <% } else { %>
                  <tr><td colspan="4" class="text-center text-muted">No Departments registered.</td></tr>
                <% } %>
              </tbody>
            </table>
          </div>
        </div>
      </div>

      <!-- Subjects Section -->
      <div class="col-lg-6">
        <div class="erp-card h-100">
          <div class="d-flex justify-content-between align-items-center mb-3">
            <h4><i class="bi bi-book text-success me-2"></i> Subjects</h4>
            <button class="btn-primary-custom btn-sm" data-bs-toggle="modal" data-bs-target="#addSubjectModal">
              <i class="bi bi-plus-lg"></i> Add Subject
            </button>
          </div>
          <div class="table-responsive">
            <table class="table table-hover align-middle">
              <thead>
                <tr>
                  <th>Code</th>
                  <th>Subject Name</th>
                  <th>Dept</th>
                  <th>Sem</th>
                  <th class="text-end">Action</th>
                </tr>
              </thead>
              <tbody>
                <% if (subjects && subjects.length > 0) { %>
                  <% subjects.forEach(sub => { %>
                    <tr>
                      <td><span class="badge bg-success"><%= sub.code %></span></td>
                      <td><%= sub.name %></td>
                      <td><%= sub.department %></td>
                      <td>Sem <%= sub.semester %></td>
                      <td class="text-end">
                        <form action="/subjects/delete" method="POST" style="display:inline;" onsubmit="return confirm('Delete subject?');">
                          <input type="hidden" name="id" value="<%= sub.id %>">
                          <button class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></button>
                        </form>
                      </td>
                    </tr>
                  <% }) %>
                <% } else { %>
                  <tr><td colspan="5" class="text-center text-muted">No Subjects registered.</td></tr>
                <% } %>
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </div>
  </main>

  <%- include('../components/footer.ejs') %>
</div>

<!-- Add Dept Modal -->
<div class="modal fade" id="addDepartmentModal" tabindex="-1">
  <div class="modal-dialog">
    <div class="modal-content">
      <form action="/departments/add" method="POST">
        <div class="modal-header">
          <h5 class="modal-title">Add Department</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
        </div>
        <div class="modal-body">
          <div class="mb-3"><label>Department Code</label><input type="text" name="code" class="form-control" placeholder="e.g. IT" required></div>
          <div class="mb-3"><label>Department Name</label><input type="text" name="name" class="form-control" placeholder="e.g. Information Technology" required></div>
          <div class="mb-3"><label>Head of Department (HOD)</label><input type="text" name="head_name" class="form-control" placeholder="e.g. Dr. S. Rao"></div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
          <button type="submit" class="btn-primary-custom">Add Department</button>
        </div>
      </form>
    </div>
  </div>
</div>

<!-- Add Subject Modal -->
<div class="modal fade" id="addSubjectModal" tabindex="-1">
  <div class="modal-dialog">
    <div class="modal-content">
      <form action="/subjects/add" method="POST">
        <div class="modal-header">
          <h5 class="modal-title">Add Subject</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
        </div>
        <div class="modal-body">
          <div class="mb-3"><label>Subject Code</label><input type="text" name="code" class="form-control" placeholder="e.g. CS401" required></div>
          <div class="mb-3"><label>Subject Name</label><input type="text" name="name" class="form-control" placeholder="e.g. Operating Systems" required></div>
          <div class="mb-3"><label>Department</label>
            <select name="department" class="form-select" required>
              <% departments.forEach(dept => { %>
                <option value="<%= dept.code %>"><%= dept.name %> (<%= dept.code %>)</option>
              <% }) %>
            </select>
          </div>
          <div class="row">
            <div class="col-6 mb-3"><label>Semester</label><input type="number" name="semester" class="form-control" value="4" required></div>
            <div class="col-6 mb-3"><label>Credits</label><input type="number" name="credits" class="form-control" value="4" required></div>
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
          <button type="submit" class="btn-primary-custom">Add Subject</button>
        </div>
      </form>
    </div>
  </div>
</div>
