<%- include('../components/header.ejs') %>
<%- include('../components/sidebar.ejs') %>

<div class="main-wrapper">
  <%- include('../components/navbar.ejs') %>

  <main class="content">
    <% if (messages && messages.success) { %>
      <div class="alert alert-success alert-dismissible fade show mb-4"><%= messages.success %><button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
    <% } %>
    <% if (messages && messages.warning) { %>
      <div class="alert alert-warning alert-dismissible fade show mb-4"><%= messages.warning %><button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
    <% } %>

    <div class="student-header">
      <div class="header-info">
        <h2>Teachers & Faculty</h2>
        <p>Manage teaching staff, designations, and departmental info.</p>
      </div>
      <div class="student-count">
        <i class="bi bi-person-workspace"></i>
        <strong><%= teacher_count %></strong> Teachers
      </div>
    </div>

    <!-- Search Card -->
    <div class="erp-card action-bar">
      <div class="row g-3 align-items-center">
        <div class="col-lg-8 col-md-7">
          <div class="search-box">
            <i class="bi bi-search"></i>
            <input type="text" id="searchTeacher" placeholder="Search by Employee ID, Name..." />
          </div>
        </div>
        <div class="col-lg-4 col-md-5 text-md-end">
          <a href="/teachers/register" class="btn-primary-custom add-btn">
            <i class="bi bi-plus-circle"></i> Add Teacher
          </a>
        </div>
      </div>
    </div>

    <div class="erp-card">
      <div class="table-responsive">
        <table class="student-table">
          <thead>
            <tr class="student-row">
              <th class="col-roll">Emp ID</th>
              <th class="col-name">Name</th>
              <th class="col-program">Department</th>
              <th class="col-year">Designation</th>
              <th class="col-section">Type</th>
              <th class="col-actions text-center">Actions</th>
            </tr>
          </thead>
          <tbody>
            <% if (teachers && teachers.length > 0) { %>
              <% teachers.forEach(teacher => { %>
                <tr class="student-row"
                    data-teacher-id="<%= teacher.teacher_id %>"
                    data-employee-id="<%= teacher.employee_id %>"
                    data-name="<%= teacher.name %>"
                    data-gender="<%= teacher.gender %>"
                    data-department="<%= teacher.department %>"
                    data-designation="<%= teacher.designation %>"
                    data-employment-type="<%= teacher.employment_type %>"
                    data-email="<%= teacher.email %>"
                    data-phone="<%= teacher.phone %>">
                  <td class="col-roll"><%= teacher.employee_id %></td>
                  <td class="col-name"><%= teacher.name %></td>
                  <td class="col-program"><%= teacher.department %></td>
                  <td class="col-year"><%= teacher.designation %></td>
                  <td class="col-section"><%= teacher.employment_type %></td>
                  <td class="col-actions">
                    <div class="action-buttons">
                      <button class="btn-view" title="View Teacher" data-bs-toggle="modal" data-bs-target="#viewTeacherModal"><i class="bi bi-eye-fill"></i></button>
                      <button class="btn-edit" title="Edit Teacher" data-bs-toggle="modal" data-bs-target="#editTeacherModal"
                              data-id="<%= teacher.teacher_id %>"
                              data-employee-id="<%= teacher.employee_id %>"
                              data-name="<%= teacher.name %>"
                              data-gender="<%= teacher.gender %>"
                              data-department="<%= teacher.department %>"
                              data-designation="<%= teacher.designation %>"
                              data-employment-type="<%= teacher.employment_type %>"
                              data-email="<%= teacher.email %>"
                              data-phone="<%= teacher.phone %>"><i class="bi bi-pencil-square"></i></button>
                      <button class="btn-delete" title="Delete Teacher" data-bs-toggle="modal" data-bs-target="#deleteTeacherModal"
                              data-id="<%= teacher.teacher_id %>"
                              data-name="<%= teacher.name %>"
                              data-employee-id="<%= teacher.employee_id %>"><i class="bi bi-trash"></i></button>
                    </div>
                  </td>
                </tr>
              <% }) %>
            <% } else { %>
              <tr class="student-row">
                <td colspan="6" class="empty-state">
                  <i class="bi bi-person-workspace"></i>
                  <h4>No Teachers Found</h4>
                  <p>Click <strong>Add Teacher</strong> to register your first teacher.</p>
                </td>
              </tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>
  </main>

  <%- include('../components/footer.ejs') %>
</div>

<!-- View Modal -->
<div class="modal fade" id="viewTeacherModal" tabindex="-1">
  <div class="modal-dialog modal-lg">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title"><i class="bi bi-person-vcard-fill"></i> Teacher Details</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body">
        <table class="table table-borderless">
          <tr><th width="220">Employee ID</th><td id="viewEmployeeId"></td></tr>
          <tr><th>Teacher Name</th><td id="viewTeacherName"></td></tr>
          <tr><th>Gender</th><td id="viewGender"></td></tr>
          <tr><th>Department</th><td id="viewDepartment"></td></tr>
          <tr><th>Designation</th><td id="viewDesignation"></td></tr>
          <tr><th>Employment Type</th><td id="viewEmploymentType"></td></tr>
          <tr><th>Email</th><td id="viewTeacherEmail"></td></tr>
          <tr><th>Phone</th><td id="viewTeacherPhone"></td></tr>
        </table>
      </div>
      <div class="modal-footer"><button class="btn btn-secondary" data-bs-dismiss="modal">Close</button></div>
    </div>
  </div>
</div>

<!-- Edit Modal -->
<div class="modal fade" id="editTeacherModal" tabindex="-1">
  <div class="modal-dialog modal-lg">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title"><i class="bi bi-pencil-square"></i> Edit Teacher</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <form method="POST" action="/update-teacher">
        <div class="modal-body">
          <div class="row g-3">
            <input type="hidden" id="editTeacherId" name="teacher_id" />
            <div class="col-md-6"><label>Employee ID</label><input type="text" id="editEmployeeId" name="employee_id" class="form-control" readonly /></div>
            <div class="col-md-6"><label>Name</label><input type="text" id="editTeacherName" name="name" class="form-control" required /></div>
            <div class="col-md-4"><label>Gender</label><input type="text" id="editGender" class="form-control" name="gender" required /></div>
            <div class="col-md-4"><label>Department</label><input type="text" id="editDepartment" class="form-control" name="department" required /></div>
            <div class="col-md-4"><label>Designation</label><input type="text" id="editDesignation" class="form-control" name="designation" required /></div>
            <div class="col-md-6"><label>Employment Type</label><input type="text" id="editEmploymentType" class="form-control" name="employment_type" required /></div>
            <div class="col-md-6"><label>Email</label><input type="email" id="editTeacherEmail" class="form-control" name="email" required /></div>
            <div class="col-md-12"><label>Phone</label><input type="text" id="editTeacherPhone" class="form-control" name="phone" required /></div>
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
          <button type="submit" class="btn-primary-custom">Save Changes</button>
        </div>
      </form>
    </div>
  </div>
</div>

<!-- Delete Modal -->
<div class="modal fade" id="deleteTeacherModal" tabindex="-1">
  <div class="modal-dialog">
    <div class="modal-content">
      <form method="POST" action="/delete-teacher">
        <div class="modal-header bg-danger text-white">
          <h5 class="modal-title"><i class="bi bi-trash-fill"></i> Delete Teacher</h5>
          <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
        </div>
        <div class="modal-body">
          <input type="hidden" id="deleteTeacherId" name="teacher_id" />
          <p>Are you sure you want to delete this teacher?</p>
          <div class="alert alert-warning">
            <strong>Name:</strong> <span id="deleteTeacherNameText"></span><br />
            <strong>Employee ID:</strong> <span id="deleteEmployeeIdText"></span>
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
          <button type="submit" class="btn btn-danger">Delete Teacher</button>
        </div>
      </form>
    </div>
  </div>
</div>

<script src="/js/teachers.js"></script>
