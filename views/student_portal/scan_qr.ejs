<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Student | Phone QR Scanner</title>
    <link rel="icon" type="image/png" href="/images/logo/camp-logo.png">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <!-- HTML5 QR Code Scanner Library -->
    <script src="https://unpkg.com/html5-qrcode" type="text/javascript"></script>
    <style>
        #reader { width: 100%; max-width: 450px; margin: 0 auto; border-radius: 16px; overflow: hidden; border: 2px solid #0d6efd; }
    </style>
</head>
<body class="bg-light">
    <nav class="navbar navbar-dark bg-primary shadow-sm mb-4">
        <div class="container d-flex justify-content-between align-items-center">
            <div class="d-flex align-items-center">
                <a class="navbar-brand font-weight-bold me-3" href="/student/dashboard">
                    <i class="bi bi-arrow-left me-2"></i> Student Portal
                </a>
                <span class="navbar-text text-white d-none d-md-inline">Scan Teacher QR Code</span>
            </div>
            <a href="/logout" class="btn btn-outline-light btn-sm"><i class="bi bi-box-arrow-right me-1"></i> Logout</a>
        </div>
    </nav>

    <div class="container text-center">
        <div class="card border-0 shadow-sm p-4 mb-4">
            <h4><i class="bi bi-qr-code-scan text-primary me-2"></i> Scan Classroom QR Code</h4>
            <p class="text-muted small mb-3">Point your phone camera at the QR code displayed on the teacher's screen to mark attendance.</p>
            
            <div id="reader"></div>

            <div id="resultMsg" class="mt-3" style="display:none;"></div>
        </div>
    </div>

    <script>
        function onScanSuccess(decodedText, decodedResult) {
            console.log("QR Code Scanned:", decodedText);
            
            let token = decodedText;
            try {
                const parsed = JSON.parse(decodedText);
                if (parsed.token) token = parsed.token;
            } catch (e) {}

            submitAttendance(token);
        }

        async function submitAttendance(token) {
            const msgDiv = document.getElementById('resultMsg');
            msgDiv.style.display = 'block';
            msgDiv.className = 'alert alert-info';
            msgDiv.innerText = 'Submitting attendance verification...';

            try {
                const response = await fetch('/student/api/scan-qr', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ token: token, subject_code: 'GEN' })
                });

                const data = await response.json();
                if (data.success) {
                    msgDiv.className = 'alert alert-success';
                    msgDiv.innerText = '✅ ' + data.message;
                    setTimeout(() => window.location.href = '/student/dashboard', 2000);
                } else {
                    msgDiv.className = 'alert alert-danger';
                    msgDiv.innerText = '❌ ' + data.message;
                }
            } catch (err) {
                msgDiv.className = 'alert alert-danger';
                msgDiv.innerText = '❌ Server communication error.';
            }
        }

        const html5QrcodeScanner = new Html5QrcodeScanner("reader", { fps: 10, qrbox: { width: 250, height: 250 } }, /* verbose= */ false);
        html5QrcodeScanner.render(onScanSuccess);
    </script>
</body>
</html>
