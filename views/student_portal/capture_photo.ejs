<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Student | Face ID Photo Capture</title>
    <link rel="icon" type="image/png" href="/images/logo/camp-logo.png">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <style>
        .capture-card {
            border-radius: 20px;
            box-shadow: 0 10px 30px rgba(0,0,0,0.08);
        }
        .camera-wrapper {
            position: relative;
            max-width: 480px;
            margin: 0 auto;
            border-radius: 16px;
            overflow: hidden;
            background: #000;
            box-shadow: 0 8px 20px rgba(0,0,0,0.15);
        }
        #videoElement {
            width: 100%;
            height: auto;
            display: block;
            border-radius: 16px;
            transform: scaleX(-1); /* Mirror view */
        }
        .face-guide-oval {
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            width: 220px;
            height: 280px;
            border: 3px dashed rgba(25, 135, 84, 0.85);
            border-radius: 50%;
            pointer-events: none;
            box-shadow: 0 0 0 9999px rgba(0, 0, 0, 0.25);
            transition: all 0.3s ease;
        }
        #previewImage {
            max-width: 100%;
            max-height: 340px;
            border-radius: 16px;
            border: 3px solid #198754;
            display: none;
        }
        #canvasElement {
            display: none;
        }
        .current-photo-badge {
            width: 90px;
            height: 90px;
            object-fit: cover;
            border-radius: 50%;
            border: 3px solid #198754;
            box-shadow: 0 4px 10px rgba(0,0,0,0.15);
        }
    </style>
</head>
<body class="bg-light">
    <nav class="navbar navbar-dark bg-success shadow-sm mb-4">
        <div class="container d-flex justify-content-between align-items-center">
            <div class="d-flex align-items-center">
                <a class="navbar-brand font-weight-bold me-3" href="/student/dashboard">
                    <i class="bi bi-arrow-left me-2"></i> Student Portal
                </a>
                <span class="navbar-text text-white d-none d-md-inline">Face ID Biometric Registration</span>
            </div>
            <a href="/logout" class="btn btn-outline-light btn-sm"><i class="bi bi-box-arrow-right me-1"></i> Logout</a>
        </div>
    </nav>

    <div class="container pb-5">
        <div class="row justify-content-center">
            <div class="col-lg-8 col-md-10">
                <div class="card capture-card border-0 p-4 p-md-5 bg-white text-center">
                    
                    <!-- Header with Student details -->
                    <div class="mb-4">
                        <h3 class="font-weight-bold text-dark mb-1">
                            <i class="bi bi-person-bounding-box text-success me-2"></i> Face ID Photo Capture
                        </h3>
                        <p class="text-muted mb-2">
                            Student: <strong><%= student.name %></strong> | Roll No: <strong><%= student.university_roll_number %></strong> (<%= student.branch %>)
                        </p>

                        <% if (student.face_registered || (student.photo_url && student.photo_url !== '')) { %>
                            <div class="d-inline-flex align-items-center bg-success-subtle px-3 py-2 rounded-pill text-success mb-2">
                                <i class="bi bi-check-circle-fill me-2"></i> 
                                <span>Current Face ID is Active. You can update it below.</span>
                            </div>
                        <% } else { %>
                            <div class="d-inline-flex align-items-center bg-warning-subtle px-3 py-2 rounded-pill text-dark mb-2">
                                <i class="bi bi-exclamation-triangle-fill me-2 text-warning"></i> 
                                <span>Face ID not enrolled yet. Please capture your photo below.</span>
                            </div>
                        <% } %>
                    </div>

                    <% if (student.photo_url && student.photo_url !== '') { %>
                        <div class="mb-4 p-3 bg-light rounded-3 d-inline-block">
                            <small class="d-block text-muted mb-2 font-weight-bold">Registered Photo on Record:</small>
                            <img src="<%= student.photo_url %>" alt="Current Face ID" class="current-photo-badge" />
                            <div class="mt-2">
                                <button type="button" id="deletePhotoBtn" class="btn btn-outline-danger btn-sm">
                                    <i class="bi bi-trash3-fill me-1"></i> Delete Face ID Photo
                                </button>
                            </div>
                        </div>
                    <% } %>

                    <!-- Camera / Preview Box -->
                    <div class="camera-wrapper mb-3" id="cameraBox">
                        <video id="videoElement" autoplay playsinline muted></video>
                        <div class="face-guide-oval" id="faceOval"></div>
                        <canvas id="canvasElement"></canvas>
                        <img id="previewImage" alt="Captured Face Preview" />
                    </div>

                    <!-- Instructions -->
                    <p class="text-muted small mb-3" id="guideText">
                        <i class="bi bi-lightbulb-fill text-warning me-1"></i>
                        Center your face within the green oval under good lighting and click <strong>Capture Photo</strong>.
                    </p>

                    <!-- Control Buttons -->
                    <div class="d-flex justify-content-center gap-2 mb-3">
                        <button type="button" id="snapBtn" class="btn btn-success btn-lg px-4 shadow-sm">
                            <i class="bi bi-camera-fill me-2"></i> Capture Photo
                        </button>
                        <button type="button" id="retakeBtn" class="btn btn-outline-secondary btn-lg px-4 d-none">
                            <i class="bi bi-arrow-counterclockwise me-2"></i> Retake
                        </button>
                        <button type="button" id="saveBtn" class="btn btn-primary btn-lg px-4 shadow-sm d-none">
                            <i class="bi bi-check-circle-fill me-2"></i> Save Face ID
                        </button>
                    </div>

                    <!-- Status Notification Alert -->
                    <div id="statusMsg" class="alert mb-3" style="display:none;"></div>

                    <!-- Fallback: Upload Photo File -->
                    <div class="border-top pt-3 mt-3">
                        <p class="text-muted small mb-2">
                            <i class="bi bi-paperclip me-1"></i> WebCam not working or permission denied?
                        </p>
                        <div class="d-flex justify-content-center">
                            <div class="input-group" style="max-width: 380px;">
                                <input type="file" id="fileUploadInput" accept="image/*" class="form-control form-control-sm" />
                                <button class="btn btn-outline-success btn-sm" type="button" id="uploadFileBtn">
                                    <i class="bi bi-upload me-1"></i> Use Photo
                                </button>
                            </div>
                        </div>
                    </div>

                    <div class="mt-4">
                        <a href="/student/dashboard" class="btn btn-link text-secondary text-decoration-none">
                            <i class="bi bi-arrow-left me-1"></i> Back to Dashboard
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script>
        const video = document.getElementById('videoElement');
        const canvas = document.getElementById('canvasElement');
        const previewImage = document.getElementById('previewImage');
        const faceOval = document.getElementById('faceOval');
        const snapBtn = document.getElementById('snapBtn');
        const retakeBtn = document.getElementById('retakeBtn');
        const saveBtn = document.getElementById('saveBtn');
        const statusMsg = document.getElementById('statusMsg');
        const guideText = document.getElementById('guideText');
        const fileUploadInput = document.getElementById('fileUploadInput');
        const uploadFileBtn = document.getElementById('uploadFileBtn');

        let currentCapturedDataUrl = null;
        let mediaStream = null;

        // Initialize WebCam Stream
        async function initCamera() {
            try {
                mediaStream = await navigator.mediaDevices.getUserMedia({
                    video: {
                        width: { ideal: 640 },
                        height: { ideal: 480 },
                        facingMode: "user"
                    }
                });
                video.srcObject = mediaStream;
                video.play();
                statusMsg.style.display = 'none';
            } catch (err) {
                console.warn("Webcam access error:", err);
                statusMsg.style.display = 'block';
                statusMsg.className = 'alert alert-warning';
                statusMsg.innerHTML = '<i class="bi bi-exclamation-circle-fill me-1"></i> Camera permission blocked or camera not available. You can use the <strong>Upload Photo</strong> option below.';
            }
        }

        // Snap Photo from Camera
        snapBtn.addEventListener('click', () => {
            const width = video.videoWidth || 640;
            const height = video.videoHeight || 480;
            canvas.width = width;
            canvas.height = height;

            const ctx = canvas.getContext('2d');
            // Un-mirror image when drawing
            ctx.translate(width, 0);
            ctx.scale(-1, 1);
            ctx.drawImage(video, 0, 0, width, height);

            currentCapturedDataUrl = canvas.toDataURL('image/jpeg', 0.9);
            showPreview(currentCapturedDataUrl);
        });

        // Show captured image preview
        function showPreview(dataUrl) {
            previewImage.src = dataUrl;
            previewImage.style.display = 'block';
            video.style.display = 'none';
            faceOval.style.display = 'none';

            snapBtn.classList.add('d-none');
            retakeBtn.classList.remove('d-none');
            saveBtn.classList.remove('d-none');

            guideText.innerHTML = '<span class="text-success font-weight-bold"><i class="bi bi-check-circle-fill me-1"></i> Snapshot ready!</span> Click <strong>Save Face ID</strong> to enroll this photo.';
        }

        // Retake Photo
        retakeBtn.addEventListener('click', () => {
            currentCapturedDataUrl = null;
            previewImage.style.display = 'none';
            video.style.display = 'block';
            faceOval.style.display = 'block';

            snapBtn.classList.remove('d-none');
            retakeBtn.classList.add('d-none');
            saveBtn.classList.add('d-none');

            guideText.innerHTML = '<i class="bi bi-lightbulb-fill text-warning me-1"></i> Center your face within the green oval and click <strong>Capture Photo</strong>.';
        });

        // Handle File Upload Fallback
        uploadFileBtn.addEventListener('click', () => {
            const file = fileUploadInput.files[0];
            if (!file) {
                alert('Please select an image file first.');
                return;
            }

            const reader = new FileReader();
            reader.onload = (e) => {
                currentCapturedDataUrl = e.target.result;
                showPreview(currentCapturedDataUrl);
            };
            reader.readAsDataURL(file);
        });

        // Save Photo to Backend
        saveBtn.addEventListener('click', async () => {
            if (!currentCapturedDataUrl) {
                alert('Please capture or upload a face photo first.');
                return;
            }

            saveBtn.disabled = true;
            retakeBtn.disabled = true;
            statusMsg.style.display = 'block';
            statusMsg.className = 'alert alert-info';
            statusMsg.innerHTML = '<i class="bi bi-hourglass-split me-1"></i> Saving Face ID photo and updating database...';

            try {
                const response = await fetch('/student/api/save-photo', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ photo_data: currentCapturedDataUrl })
                });

                const data = await response.json();
                if (data.success) {
                    statusMsg.className = 'alert alert-success';
                    statusMsg.innerHTML = '<i class="bi bi-check-circle-fill me-1"></i> ' + data.message + ' Redirecting to Dashboard...';
                    
                    // Stop camera hardware stream
                    if (mediaStream) {
                        mediaStream.getTracks().forEach(t => t.stop());
                    }

                    setTimeout(() => {
                        window.location.href = '/student/dashboard';
                    }, 1500);
                } else {
                    statusMsg.className = 'alert alert-danger';
                    statusMsg.innerHTML = '<i class="bi bi-x-circle-fill me-1"></i> ' + (data.message || 'Failed to save photo.');
                    saveBtn.disabled = false;
                    retakeBtn.disabled = false;
                }
            } catch (err) {
                console.error(err);
                statusMsg.className = 'alert alert-danger';
                statusMsg.innerHTML = '<i class="bi bi-x-circle-fill me-1"></i> Network error while saving photo. Please try again.';
                saveBtn.disabled = false;
                retakeBtn.disabled = false;
            }
        });

        // Delete Registered Face Photo Handler
        const deletePhotoBtn = document.getElementById('deletePhotoBtn');
        if (deletePhotoBtn) {
            deletePhotoBtn.addEventListener('click', async () => {
                if (!confirm('Kya aap sach me apni Face ID photo delete karna chahte hain?')) {
                    return;
                }

                deletePhotoBtn.disabled = true;
                statusMsg.style.display = 'block';
                statusMsg.className = 'alert alert-info';
                statusMsg.innerHTML = '<i class="bi bi-hourglass-split me-1"></i> Deleting Face ID photo...';

                try {
                    const res = await fetch('/student/api/delete-photo', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' }
                    });
                    const data = await res.json();
                    if (data.success) {
                        statusMsg.className = 'alert alert-success';
                        statusMsg.innerHTML = '<i class="bi bi-check-circle-fill me-1"></i> ' + data.message + ' Redirecting to Dashboard...';
                        setTimeout(() => {
                            window.location.href = '/student/dashboard';
                        }, 1200);
                    } else {
                        statusMsg.className = 'alert alert-danger';
                        statusMsg.innerHTML = '<i class="bi bi-x-circle-fill me-1"></i> ' + (data.message || 'Failed to delete photo.');
                        deletePhotoBtn.disabled = false;
                    }
                } catch (err) {
                    console.error(err);
                    statusMsg.className = 'alert alert-danger';
                    statusMsg.innerHTML = '<i class="bi bi-x-circle-fill me-1"></i> Network error deleting photo.';
                    deletePhotoBtn.disabled = false;
                }
            });
        }

        window.addEventListener('DOMContentLoaded', initCamera);

        // Stop camera if user leaves page
        window.addEventListener('beforeunload', () => {
            if (mediaStream) {
                mediaStream.getTracks().forEach(t => t.stop());
            }
        });
    </script>
</body>
</html>
