<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Student | My Attendance Reports</title>
    <link rel="icon" type="image/png" href="/images/logo/camp-logo.png">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <style>
        .mobile-card { border-radius: 16px; box-shadow: 0 10px 25px rgba(0,0,0,0.05); }
    </style>
</head>
<body class="bg-light">
    <nav class="navbar navbar-dark bg-success shadow-sm mb-4">
        <div class="container d-flex justify-content-between align-items-center">
            <div class="d-flex align-items-center">
                <a class="navbar-brand font-weight-bold me-3" href="/student/dashboard">
                    <i class="bi bi-arrow-left me-2"></i> Student Portal
                </a>
                <span class="navbar-text text-white d-none d-md-inline">My Detailed Attendance Reports</span>
            </div>
            <a href="/logout" class="btn btn-outline-light btn-sm"><i class="bi bi-box-arrow-right me-1"></i> Logout</a>
        </div>
    </nav>

    <div class="container py-2">
        <!-- Summary Stats Grid -->
        <div class="row g-3 mb-4 text-center">
            <div class="col-4">
                <div class="card mobile-card border-0 bg-white p-3">
                    <h3 class="text-success mb-0"><%= stats.presentDays %></h3>
                    <small class="text-muted">Present</small>
                </div>
            </div>
            <div class="col-4">
                <div class="card mobile-card border-0 bg-white p-3">
                    <h3 class="text-warning mb-0"><%= stats.lateDays %></h3>
                    <small class="text-muted">Late</small>
                </div>
            </div>
            <div class="col-4">
                <div class="card mobile-card border-0 bg-white p-3">
                    <h3 class="text-danger mb-0"><%= stats.absentDays %></h3>
                    <small class="text-muted">Absent</small>
                </div>
            </div>
        </div>

        <!-- Detailed Log Table with Teacher Updates -->
        <div class="card mobile-card border-0 bg-white p-4 mb-4">
            <h5 class="card-title mb-3"><i class="bi bi-journal-text text-success me-2"></i> Attendance Log & Teacher Updates</h5>
            <p class="text-muted small">Below are your attendance records as updated and verified by your class teachers.</p>
            
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead>
                        <tr>
                            <th>Date</th>
                            <th>Subject</th>
                            <th>Time</th>
                            <th>Verification Mode</th>
                            <th>Status</th>
                            <th>Teacher Remarks / Updates</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (history && history.length > 0) { %>
                            <% history.forEach(log => { %>
                                <tr>
                                    <td><strong><%= log.date %></strong></td>
                                    <td><span class="badge bg-secondary"><%= log.subject_code %></span></td>
                                    <td><%= log.time %></td>
                                    <td><small class="text-muted"><%= log.verification_mode %> (<%= log.marked_by %>)</small></td>
                                    <td>
                                        <span class="badge bg-<%= log.status === 'Present' ? 'success' : (log.status === 'Late' ? 'warning text-dark' : 'danger') %>">
                                            <%= log.status %>
                                        </span>
                                    </td>
                                    <td>
                                        <% if (log.remarks && log.remarks.trim() !== '') { %>
                                            <span class="badge bg-light text-dark border"><i class="bi bi-chat-left-text me-1"></i> <%= log.remarks %></span>
                                        <% } else { %>
                                            <small class="text-muted">No remarks</small>
                                        <% } %>
                                    </td>
                                </tr>
                            <% }) %>
                        <% } else { %>
                            <tr>
                                <td colspan="6" class="text-center text-muted py-4">No attendance records found.</td>
                            </tr>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</body>
</html>
