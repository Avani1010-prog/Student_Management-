<%- include('../components/header.ejs') %>
<%- include('../components/sidebar.ejs') %>

<div class="main-wrapper">
  <%- include('../components/navbar.ejs') %>

  <main class="content">
    <div class="student-header mb-4">
      <div class="header-info">
        <h2>Reports & Analytics</h2>
        <p>Export attendance records to CSV and view institution statistics (Version 1.0 ERP Module).</p>
      </div>
      <div>
        <a href="/reports/export/csv?date=<%= filterDate %>" class="btn btn-success btn-lg">
          <i class="bi bi-file-earmark-spreadsheet-fill me-2"></i> Download CSV Report
        </a>
      </div>
    </div>

    <div class="row g-4 mb-4">
      <div class="col-md-4">
        <div class="erp-card text-center py-4">
          <i class="bi bi-mortarboard-fill text-primary display-5 mb-2"></i>
          <h5>Total Students</h5>
          <h3><%= totalStudents %></h3>
        </div>
      </div>
      <div class="col-md-4">
        <div class="erp-card text-center py-4">
          <i class="bi bi-person-workspace text-success display-5 mb-2"></i>
          <h5>Total Faculty</h5>
          <h3><%= totalTeachers %></h3>
        </div>
      </div>
      <div class="col-md-4">
        <div class="erp-card text-center py-4">
          <i class="bi bi-clipboard-check-fill text-warning display-5 mb-2"></i>
          <h5>Filtered Date Records</h5>
          <h3><%= attendanceLogs.length %></h3>
        </div>
      </div>
    </div>

    <!-- Attendance Table Report -->
    <div class="erp-card">
      <div class="d-flex justify-content-between align-items-center mb-3">
        <h4><i class="bi bi-table me-2"></i> Attendance Log History</h4>
        <form action="/reports" method="GET" class="d-flex align-items-center gap-2">
          <label class="form-label mb-0 small">Date Filter:</label>
          <input type="date" name="date" class="form-control form-control-sm" value="<%= filterDate %>" onchange="this.form.submit()">
        </form>
      </div>

      <div class="table-responsive">
        <table class="table table-striped table-hover align-middle">
          <thead>
            <tr>
              <th>ID</th>
              <th>Student Name</th>
              <th>Roll Number</th>
              <th>Subject</th>
              <th>Date</th>
              <th>Time</th>
              <th>Mode</th>
              <th>Status</th>
            </tr>
          </thead>
          <tbody>
            <% if (attendanceLogs && attendanceLogs.length > 0) { %>
              <% attendanceLogs.forEach(log => { %>
                <tr>
                  <td>#<%= log.id %></td>
                  <td><strong><%= log.student_name %></strong></td>
                  <td><%= log.university_roll_number %></td>
                  <td><span class="badge bg-secondary"><%= log.subject_code %></span></td>
                  <td><%= log.date %></td>
                  <td><%= log.time %></td>
                  <td><span class="badge bg-info text-dark"><%= log.verification_mode %></span></td>
                  <td><span class="badge bg-success">Present</span></td>
                </tr>
              <% }) %>
            <% } else { %>
              <tr>
                <td colspan="8" class="text-center py-4 text-muted">No attendance logs available for date <%= filterDate %>.</td>
              </tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>
  </main>

  <%- include('../components/footer.ejs') %>
</div>
